# ============================================================
# Teligencia workspace — top-level .gitignore
# Covers the three projects: teligencia-lab, teligencia-customer, teligencia-api.
# Each project also keeps its own .gitignore for tool-specific rules.
# ============================================================

# --- dependencies ---
**/node_modules/
.pnp
.pnp.js
.pnp.cjs

# --- build output ---
**/dist/
**/build/
**/out-tsc/
**/.angular/cache/
**/tmp/
**/bazel-out/

# --- nest / typescript build artefacts ---
**/*.tsbuildinfo
**/.tsbuildinfo

# --- environment & secrets ---
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.pfx
.envrc

# --- logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
**/logs/

# --- coverage & test output ---
**/coverage/
**/.nyc_output/
**/junit.xml
**/jest-cache/

# --- IDE / editor ---
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
*.swp
*.swo
*.iml
.history/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.project
.classpath
.settings/

# --- macOS / Windows / Linux ---
.DS_Store
.AppleDouble
.LSOverride
Icon?
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Angular CLI specifics ---
**/.angular/
**/connect.lock
**/libpeerconnection.log
**/testem.log
**/typings/

# --- NestJS specifics ---
**/.webpack/

# --- package manager state ---
.npm/
.yarn-integrity
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnpm-store/

# --- temp / OS / scratch ---
*.tmp
*.tmp.*
*.bak
*.orig
*.swap
*.local
.cache/

# --- claude / agent runtime droppings ---
.specify/init-options.json
